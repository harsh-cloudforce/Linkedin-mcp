# LinkedIn Feed Scroller — deployed MCP (Azure Container Apps)
# Fill FQDN + token from Cloud Shell output. Do not commit real secrets.

AZURE_RESOURCE_GROUP=rg-linkedin-market-pulse
AZURE_CONTAINER_APP=linkedin-feed-scroller
AZURE_ACR=acrlinpulse12449
AZURE_LOCATION=eastus2

MCP_FQDN=
MCP_HEALTH_URL=https://${MCP_FQDN}/healthz
MCP_URL=https://${MCP_FQDN}/mcp
PUBLIC_BASE_URL=https://${MCP_FQDN}

MCP_BEARER_TOKEN=
MCP_AUTHORIZATION=Bearer ${MCP_BEARER_TOKEN}
