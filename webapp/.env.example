# Market Pulse webapp
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8790
PUBLIC_BASE_URL=

# UI admin (invite-only login)
ADMIN_EMAIL=you@company.com
ADMIN_PASSWORD=change-me-strong-password
SESSION_SECRET=change-me-long-random-string
SESSION_SECURE=false
REQUIRE_API_KEY=true

# Shared secret for nebulaONE MCP + /api/integration/* (generate in Settings on Azure)
INTEGRATION_API_KEY=

# LinkedIn scroller MCP (Azure secrets — not editable in UI)
SCROLLER_MCP_URL=https://linkedin-feed-scroller.whitesand-f9361ec3.eastus2.azurecontainerapps.io/mcp
SCROLLER_BEARER_TOKEN=

# Daily automation (UTC)
DAILY_SCAN_ENABLED=true
DAILY_SCAN_HOUR_UTC=13
DAILY_SCAN_MINUTE_UTC=0

# SQLite directory
DATA_DIR=./data
