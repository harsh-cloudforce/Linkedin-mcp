# Copy to .env and adjust
SCROLLER_HOST=127.0.0.1
SCROLLER_PORT=8787
# Directory for per-user Chromium profiles (LinkedIn sessions)
# Keep OFF OneDrive — default uses %LOCALAPPDATA%\LinkedInMarketPulse\profiles
PROFILES_DIR=
# Default scan limits
DEFAULT_MAX_POSTS=60
DEFAULT_MAX_SCROLLS=20
# true = show browser (easier first login); false = headless after session exists
DEFAULT_HEADED=true
# Optional shared API key; if set, clients must send header X-Api-Key
API_KEY=
# Stable browser install path (avoid temp/sandbox caches)
PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers
